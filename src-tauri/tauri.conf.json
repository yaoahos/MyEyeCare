{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyEyeCare",
  "version": "1.0.0",
  "identifier": "com.yaoahos.myeyecare",
  "mainBinaryName": "MyEyeCare",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "app": {
    "appDirectoriesOverride": "./data",
    "windows": [
      {
        "label": "main",
        "title": "MyEyeCare",
        "width": 680,
        "height": 550,
        "minWidth": 680,
        "minHeight": 550,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' https://api.github.com https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "轻量级护眼工具",
    "longDescription": "通过调节屏幕亮度与色温减轻视觉疲劳，支持护眼模板、开机自启与托盘驻留。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
